{
  "name": "@juspay-tech/react-hyperswitch",
  "version": "1.0.0",
  "description": "Universal React bindings for Hyperswitch",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "sh-iv-am",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh-iv-am/capacitor-react-hyperswitch.git"
  },
  "bugs": {
    "url": "https://github.com/sh-iv-am/capacitor-react-hyperswitch/issues"
  },
  "keywords": [
    "capacitor",
    "capacitor-react",
    "plugin",
    "native"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  }
}
