{
  // Type-checks type-tests/ against the PUBLISHED declarations in dist/types, under the SAME
  // compiler configuration a React Native app uses: the stock @react-native/typescript-config,
  // whose lib list contains no "dom". That is what makes the AbortSignal assertion meaningful — it
  // proves the published type resolves from React Native's own globals rather than from a DOM lib
  // this repository happens to have available locally.
  //
  // Runs last in `yarn build`, after tsc has emitted the declarations.
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "react-native"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "type-tests/**/*.ts",
    "type-tests/**/*.tsx"
  ]
}
