{
  "name": "react-native-hyperswitch-vault",
  "namespace": true,
  "jsx": {
    "version": 4
  },
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "bsc-flags": [
    "-bs-super-errors",
    "-open RescriptCore"
  ],
  "suffix": ".bs.js",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "./shared-code/sdk-utils",
      "subdirs": true
    }
  ],
  "bs-dependencies": [
    "@rescript/react",
    "rescript-react-native",
    "@rescript/core"
  ],
  "gentypeconfig": {
    "module": "esmodule",
    "generatedFileExtension": ".gen.tsx"
  }
}
